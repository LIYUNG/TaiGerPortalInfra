{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "lib": ["es2020", "dom"],
        "declaration": true,
        "outDir": "./dist",
        "declarationDir": "./dist/types",
        "strict": true,
        "noImplicitAny": true,
        "strictNullChecks": true,
        "noImplicitThis": true,
        "alwaysStrict": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "noImplicitReturns": true,
        "noFallthroughCasesInSwitch": false,
        "inlineSourceMap": true,
        "inlineSources": true,
        "esModuleInterop": true,
        "experimentalDecorators": true,
        "strictPropertyInitialization": false,
        "forceConsistentCasingInFileNames": true,
        // Each file must be transpilable on its own. Both of our compilers
        // already work that way — esbuild bundles the Lambda file-by-file, and
        // it lets ts-jest transpile instead of building a full TypeScript
        // program per worker. That program (aws-cdk-lib's type surface is
        // enormous) was ~900MB and was OOM-killing the CodeBuild synth step.
        // Type checking is not lost: `npm run typecheck` does it properly.
        "isolatedModules": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "typeRoots": ["./node_modules/@types"]
    },
    "include": [
        "bin/**/*.ts",
        "lib/**/*.ts",
        "lambda/**/*.ts",
        "constructs/**/*.ts",
        "configuration/**/*.ts",
        "constants/**/*.ts",
        "types/**/*.ts",
        "test/**/*.ts"
    ],
    "exclude": ["node_modules", "cdk.out", "dist"]
}
